---
# Core 2.14.18 is part of the tested compatibility matrix.
supported_ansible_also:
  - '2.14'
# Golden-image role guidance requires lowercase operation names.
skip_list:
  - name[casing]
  # Internals use a collection-and-role prefix rather than only the role prefix.
  # tests/testcollection.py enforces the stronger namespace on every state writer.
  - var-naming[no-role-prefix]
exclude_paths:
  - .venv/
  - .ansible/
